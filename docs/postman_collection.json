{
  "info": {
    "name": "Headworld Campus Facility Management API",
    "_postman_id": "c1f7b19a-9e32-475a-bc81-8935c1de1a20",
    "description": "Collection of requests for Headworld Campus Facility Management RESTful API v1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestSlug",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login (Step 1 - Request 2FA OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@headworld.edu\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "2. Verify 2FA OTP (Step 2 - Issue Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_token\": \"PASTE_CHALLENGE_TOKEN_FROM_STEP_1\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-2fa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-2fa"
              ]
            }
          }
        },
        {
          "name": "3. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        },
        {
          "name": "4. Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Service Categories",
      "item": [
        {
          "name": "List Active Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Service Requests",
      "item": [
        {
          "name": "Query Requests (Paginated & Filterable)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests?status=submitted&priority=emergency&per_page=15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "submitted"
                },
                {
                  "key": "priority",
                  "value": "emergency"
                },
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            }
          }
        },
        {
          "name": "Lodge Service Request (with Attachments)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "service_category_id",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "priority",
                  "value": "emergency",
                  "type": "text"
                },
                {
                  "key": "building",
                  "value": "Queen's Hall",
                  "type": "text"
                },
                {
                  "key": "wing_floor",
                  "value": "Level 2",
                  "type": "text"
                },
                {
                  "key": "room_number",
                  "value": "Room 204",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Sparking fuse box on 2nd floor",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Continuous electric humming with visible sparks near classroom doorway.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests"
              ]
            }
          }
        },
        {
          "name": "Get Service Request Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestSlug}}"
              ]
            }
          }
        },
        {
          "name": "Assign Technician (Admin Triage)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigned_officer_id\": 2,\n  \"notes\": \"Immediate dispatch for high risk hazard.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestSlug}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestSlug}}",
                "assign"
              ]
            }
          }
        },
        {
          "name": "Update Work Order Status (Technician)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "status",
                  "value": "resolved",
                  "type": "text"
                },
                {
                  "key": "notes",
                  "value": "Defective 40A breaker isolated and replaced. Thermal scan verified normal.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestSlug}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestSlug}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Cancel Request (Requester Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Fault resolved prior to technician dispatch.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestSlug}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestSlug}}",
                "cancel"
              ]
            }
          }
        }
      ]
    }
  ]
}